# Copy to deploy/.env and fill in. Compose reads THIS file (as .env) for both
# ${VAR} interpolation (db service) and the backend container's environment.

# --- MySQL (db service) ---
MYSQL_DATABASE=crypto_trader
MYSQL_USER=crypto_user
MYSQL_PASSWORD=CHANGE_ME_strong_db_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password

# --- Backend ---
# Host is the compose service name "db". Must match the MySQL_* values above.
DATABASE_URL=mysql+pymysql://crypto_user:CHANGE_ME_strong_db_password@db:3306/crypto_trader
APP_ENV=production
LOG_LEVEL=INFO
# Same-origin behind Caddy, so CORS isn't exercised; set for completeness.
FRONTEND_ORIGIN=https://trade.mad-apps.co.za

# --- Login gate (STRONGLY recommended for internet exposure) ---
# Leave blank for the first boot, then enrol:
#   docker compose exec backend python -m app.auth_setup
# (scan the QR), which writes TOTP_SECRET below — then: docker compose up -d
TOTP_SECRET=
AUTH_SECRET_KEY=CHANGE_ME_random_long_string
SESSION_TTL_HOURS=12
TOTP_ISSUER=Crypto Swing-Trader
TOTP_ACCOUNT=owner

# --- Crypto data (Binance public API, no key needed) ---
PRICE_PROVIDER=binance
BINANCE_BASE_URL=https://data-api.binance.vision
QUOTE_CURRENCY=USDT
FEAR_GREED_URL=https://api.alternative.me/fng/
SENS_RSS_URL=https://cointelegraph.com/rss

# --- Optional keys (safe to leave blank) ---
MARKETAUX_API_KEY=
EODHD_API_KEY=
ALPHAVANTAGE_API_KEY=
OILPRICE_API_KEY=

# Database
DATABASE_URL=mysql+pymysql://jse_user:changeme@localhost:3306/jse_swingtrader

# Data providers (fill in your own keys; leave blank to disable a provider)
EODHD_API_KEY=
ALPHAVANTAGE_API_KEY=
MARKETAUX_API_KEY=
OILPRICE_API_KEY=

# App
APP_ENV=development
LOG_LEVEL=INFO
# Active price provider: yahoo (default, free, no key) or eodhd (needs EODHD_API_KEY)
PRICE_PROVIDER=yahoo
# SENS announcements RSS feed (no key; free feeds may be empty). Blank = disabled.
SENS_RSS_URL=https://www.moneyweb.co.za/tools-and-data/sens/feed/

# Signal engine weights (must sum to 1.0)
WEIGHT_TECHNICAL=0.5
WEIGHT_MACRO=0.2
WEIGHT_SENTIMENT=0.3
DEFAULT_HORIZON_DAYS=10

# Direction thresholds on the fused score (-1..1)
BUY_THRESHOLD=0.3
SELL_THRESHOLD=-0.3

# Position sizing / stops
ACCOUNT_SIZE=100000
RISK_PER_TRADE_PCT=1.0
ATR_STOP_MULTIPLE=2.0

# Paper-trade costs — honesty req: no cost-free sims
BROKERAGE_PCT=0.1
SLIPPAGE_PCT=0.1
# SA Securities Transfer Tax: 0.25% on BUYS only
STT_PCT=0.25

# Liquidity & portfolio risk controls
MIN_LIQUIDITY_ZAR=2000000
LIQUIDITY_LOOKBACK_DAYS=20
# Cross-sectional momentum layer (0 = disabled; enable via Settings)
WEIGHT_MOMENTUM=0.0
MOMENTUM_LOOKBACK_DAYS=90
MOMENTUM_SKIP_DAYS=5
# Portfolio caps when opening paper trades
MAX_OPEN_POSITIONS=10
MAX_POSITIONS_PER_SECTOR=3
# Trailing stop: % below highest close since entry (0 = disabled)
TRAILING_STOP_PCT=0

# CORS origin for the Vite dev server
FRONTEND_ORIGIN=http://localhost:5173

# --- Auth: global TOTP gate (Google Authenticator) ---
# BLANK = login disabled. Generate with: python -m app.auth_setup  (scan the QR),
# which also writes the secret here for you.
TOTP_SECRET=
AUTH_SECRET_KEY=
SESSION_TTL_HOURS=12
TOTP_ISSUER=Crypto Swing-Trader
TOTP_ACCOUNT=owner
